{
  "name": "react-prune",
  "version": "2.0.4",
  "bin": {
    "react-prune": "./bin/react-prune"
  },
  "scripts": {
    "format": "prettier --write .",
    "release": "changeset publish",
    "test": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react-native",
    "nextjs",
    "analysis",
    "dead-code",
    "imports",
    "dependency-analysis",
    "bundle-size",
    "prune",
    "bash",
    "cli"
  ],
  "author": "Daniel Arikawe",
  "license": "MIT",
  "files": [
    "bin",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljohnson18/react-prune.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/danieljohnson18/react-prune/issues"
  },
  "homepage": "https://github.com/danieljohnson18/react-prune#readme",
  "description": "A powerful CLI tool to monitor package usage, analyze component imports, and detect dead code across React, Next.js, and React Native applications.",
  "dependencies": {
    "depcheck": "^1.4.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.10",
    "prettier": "^3.8.1",
    "vitest": "^4.0.18"
  }
}
