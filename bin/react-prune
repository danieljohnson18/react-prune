#!/bin/bash

# bin/react-prune

# Get the directory where the script is located
# Get the directory where the script is located, resolving symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(pwd)"

CORE_DIR="$SCRIPT_DIR/../scripts/core"

function show_help {
    echo "react-prune - Bash Edition"
    echo "Usage:"
    echo "  react-prune analyze    Run full analysis (deps, files, exports)"
    echo "  react-prune help       Show this help"
}

if [ "$1" == "analyze" ]; then
    shift
    
    ROOT_DIR="."
    INTERACTIVE="false"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --interactive|-i)
                INTERACTIVE="true"
                shift
                ;;
            *)
                if [[ "$1" != -* ]]; then
                    ROOT_DIR="$1"
                fi
                shift
                ;;
        esac
    done

    echo "🚀 Starting React Prune Analysis..."
    if [ "$ROOT_DIR" != "." ]; then
        echo "📂 Target: $ROOT_DIR"
    fi
    
    EXIT_CODE=0

    # 1. Check Deps
    # Passing ROOT_DIR to check_deps if it supports it (it should run in that dir)
    (cd "$ROOT_DIR" && "$CORE_DIR/check_deps.sh")
    if [ $? -ne 0 ]; then EXIT_CODE=1; fi
    echo ""

    # 1b. Check Package Sizes
    "$CORE_DIR/check_package_sizes.sh" "$ROOT_DIR"
    if [ $? -ne 0 ]; then EXIT_CODE=1; fi
    echo ""
    
    # 2. Check Unused Files
    "$CORE_DIR/check_unused_files.sh" "$ROOT_DIR" "$INTERACTIVE"
    if [ $? -ne 0 ]; then EXIT_CODE=1; fi
    echo ""
    
    # 3. Check Unused Exports
    "$CORE_DIR/check_unused_exports.sh" "$ROOT_DIR"
    if [ $? -ne 0 ]; then EXIT_CODE=1; fi
    
    if [ $EXIT_CODE -ne 0 ]; then
        echo ""
        echo "❌ Issues found."
        exit 1
    else
        echo ""
        echo "✅ All checks passed!"
        exit 0
    fi
    
elif [ "$1" == "find" ]; then
    shift
    "$CORE_DIR/find_usage.sh" "$1" "$PROJECT_ROOT"

elif [ "$1" == "--version" ] || [ "$1" == "-v" ]; then
    # Read version from package.json using grep/sed to avoid jq dependency
    VERSION=$(grep '"version":' "$CORE_DIR/../../package.json" | head -1 | sed -E 's/.*"version": "([^"]+)".*/\1/')
    echo "react-prune version $VERSION"
    exit 0

elif [ "$1" == "help" ] || [ -z "$1" ]; then
    show_help
else
    echo "Unknown command: $1"
    show_help
    exit 1
fi
